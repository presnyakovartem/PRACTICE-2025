QMainWindow {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #0a0a0a, stop: 0.5 #1a1a2e, stop: 1 #16213e);
    color: #e2e2e2;
    font-family: 'Segoe UI', 'Roboto', sans-serif;
}

QWidget {
    background: transparent;
    color: #e2e2e2;
}

QGroupBox {
    font-size: 14px;
    font-weight: bold;
    color: #00d4ff;
    background: rgba(10, 15, 30, 0.8);
    border: 2px solid #00d4ff;
    border-radius: 12px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 10px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00d4ff, stop:1 #0077ff);
    color: #000000;
    border-radius: 8px;
    font-weight: bold;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4a4a4a, stop:1 #2a2a2a);
    border: 2px solid #00d4ff;
    border-radius: 8px;
    color: #00d4ff;
    font-weight: bold;
    padding: 8px 16px;
    font-size: 12px;
    min-width: 80px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5a5a5a, stop:1 #3a3a3a);
    border-color: #00f2ff;
    color: #00f2ff;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3a3a3a, stop:1 #1a1a1a);
    border-color: #0077ff;
}

QPushButton:disabled {
    background: #2a2a2a;
    border-color: #555555;
    color: #777777;
}

QSlider::groove:horizontal {
    border: 1px solid #333333;
    height: 8px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2a2a, stop:1 #4a4a4a);
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #00d4ff, stop:1 #0077ff);
    border: 2px solid #ffffff;
    width: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #00f2ff, stop:1 #0099ff);
    border: 2px solid #ffffff;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00d4ff, stop:1 #0077ff);
    border-radius: 4px;
}

QSpinBox {
    background: rgba(20, 25, 45, 0.9);
    border: 2px solid #00d4ff;
    border-radius: 6px;
    color: #00d4ff;
    font-weight: bold;
    padding: 4px 8px;
    selection-background-color: #0077ff;
}

QSpinBox:focus {
    border-color: #00f2ff;
}

QSpinBox::up-button, QSpinBox::down-button {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4a4a4a, stop:1 #2a2a2a);
    border: 1px solid #00d4ff;
    border-radius: 3px;
    width: 16px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5a5a5a, stop:1 #3a3a3a);
}

QSpinBox::up-arrow {
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iOCIgaGVpZ2h0PSI4IiB2aWV3Qm94PSIwIDAgOCA4IiBmaWxsPSIjMDBkNGRmIj48cGF0aCBkPSJNMy41IDIuNUw0LjUgMy41IDQuNSA3LjUgMy41IDcuNSAzLjUgMy41IDIuNSAyLjVaIi8+PC9zdmc+);
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow {
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iOCIgaGVpZ2h0PSI4IiB2aWV3Qm94PSIwIDAgOCA4IiBmaWxsPSIjMDBkNGRmIj48cGF0aCBkPSJNMy41IDUuNUw0LjUgNC41IDQuNSAwLjUgMy41IDAuNSAzLjUgNC41IDIuNSA1LjVaIi8+PC9zdmc+);
    width: 8px;
    height: 8px;
}

QTabWidget::pane {
    border: 2px solid #00d4ff;
    border-radius: 8px;
    background: rgba(10, 15, 30, 0.9);
}

QTabWidget::tab-bar {
    alignment: center;
}

QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4a4a4a, stop:1 #2a2a2a);
    border: 2px solid #00d4ff;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 16px;
    color: #00d4ff;
    font-weight: bold;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #00d4ff, stop:1 #0077ff);
    color: #000000;
    border-color: #00d4ff;
}

QTabBar::tab:hover:!selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5a5a5a, stop:1 #3a3a3a);
    border-color: #00f2ff;
    color: #00f2ff;
}

QTableWidget {
    background: rgba(15, 20, 35, 0.9);
    border: 2px solid #00d4ff;
    border-radius: 6px;
    gridline-color: #333333;
    color: #e2e2e2;
    font-size: 12px;
}

QTableWidget::item {
    padding: 4px;
    border-bottom: 1px solid #333333;
}

QTableWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00d4ff, stop:1 #0077ff);
    color: #000000;
    font-weight: bold;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2a2a2a, stop:1 #1a1a1a);
    color: #00d4ff;
    font-weight: bold;
    padding: 6px;
    border: 1px solid #333333;
}

QLabel {
    color: #e2e2e2;
    font-size: 12px;
    font-weight: normal;
}

QLabel[class="title"] {
    color: #00d4ff;
    font-size: 16px;
    font-weight: bold;
}

QScrollBar:vertical {
    border: 1px solid #333333;
    background: #2a2a2a;
    width: 15px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00d4ff, stop:1 #0077ff);
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00f2ff, stop:1 #0099ff);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

FireCanvas {
    border: 3px solid #00d4ff;
    border-radius: 8px;
    background: #000000;
}

QPushButton[important="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ff4444, stop:1 #cc0000);
    border: 2px solid #ff0000;
    color: #ffffff;
    font-weight: bold;
}

QPushButton[important="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ff6666, stop:1 #dd2222);
    border-color: #ff3333;
}